# 任意: Google ログインと保存(未設定ならログイン機能は非表示で、ブラウザ保存のみ)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 任意: お問い合わせをメールで受けるときの宛先(Firebase 未設定のときに使う)
NEXT_PUBLIC_CONTACT_EMAIL=

# 任意: お問い合わせを、メールで受け取る外部サービス(Web3Forms)のアクセスキー(サイトの入力欄から、そこへ送る)
NEXT_PUBLIC_WEB3FORMS_KEY=

# 公開時に設定する(任意)
# 公開するサイトのURL(sitemap・OGP・canonicalに使う。末尾の / は不要)
NEXT_PUBLIC_SITE_URL=
# Cloudflare Web Analytics のトークン(Cookieなし・個人を特定しない閲覧数の集計)
NEXT_PUBLIC_CF_BEACON_TOKEN=
# Google アナリティクス(GA4)の測定ID(G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
# Google Search Console の所有確認(HTMLタグ方式の content の値)
NEXT_PUBLIC_GSC_VERIFICATION=
# 検索に載せない(身内確認の間だけ 1 にする。本公開するときは消す)
NEXT_PUBLIC_NOINDEX=
